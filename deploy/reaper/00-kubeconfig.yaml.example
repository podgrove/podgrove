# Optional template: replace namespace and image, then save as YAML in a separate reviewed output directory.
apiVersion: v1
kind: ConfigMap
metadata:
  name: podgrove-reaper-kubeconfig
  namespace: PODGROVE_NAMESPACE
data:
  config: "apiVersion: v1\nkind: Config\nclusters:\n- name: in-cluster\n  cluster:\n\
    \    server: https://kubernetes.default.svc\n    certificate-authority: /var/run/podgrove/auth/ca.crt\n\
    users:\n- name: podgrove-reaper\n  user:\n    tokenFile: /var/run/podgrove/auth/token\n\
    contexts:\n- name: podgrove-reaper\n  context:\n    cluster: in-cluster\n    user:\
    \ podgrove-reaper\n    namespace: PODGROVE_NAMESPACE\ncurrent-context: podgrove-reaper\n"
