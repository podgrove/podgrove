{
  "name": "podgrove-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:docs": "node scripts/prepare.mjs",
    "dev": "npm run prepare:docs && astro dev --host 127.0.0.1",
    "build": "npm run prepare:docs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5"
  }
}
